{
	"redirects": [
		{
			"source": "/products/:path*",
			"destination": "/",
			"permanent": true
		},
		{
			"source": "/xmlrpc.php",
			"destination": "/",
			"permanent": true
		},
		{
			"source": "/:path*.php",
			"destination": "/",
			"permanent": true
		},
		{
			"source": "/2025/:path*",
			"destination": "/",
			"permanent": true
		},
		{
			"source": "/2026/:path*",
			"destination": "/",
			"permanent": true
		},
		{
			"source": "/wp-:path*",
			"destination": "/",
			"permanent": true
		},
		{
			"source": "/.env:path*",
			"destination": "/",
			"permanent": true
		},
		{
			"source": "/.git:path*",
			"destination": "/",
			"permanent": true
		}
	],
	"headers": [
		{
			"source": "/(.*)\\.(ico|png|jpg|jpeg|svg|webp|avif|woff2|woff)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		},
		{
			"source": "/sitemap.xml",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=86400, stale-while-revalidate=86400"
				},
				{
					"key": "Content-Type",
					"value": "application/xml; charset=utf-8"
				}
			]
		},
		{
			"source": "/robots.txt",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=86400, stale-while-revalidate=86400"
				},
				{
					"key": "Content-Type",
					"value": "text/plain; charset=utf-8"
				}
			]
		}
	]
}
